@page "/organizations"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Localization
@using OutreachFlow.Application.Contacts
@using OutreachFlow.Application.Organizations
@using OutreachFlow.Web
@using OutreachFlow.Web.Contacts
@using OutreachFlow.Web.Organizations
@inject OrganizationApiClient OrganizationClient
@inject OrganizationTypeApiClient OrganizationTypeClient
@inject ContactApiClient ContactClient
@inject IStringLocalizer<SharedResource> Localizer
@inject IJSRuntime JS

<PageTitle>@Localizer["Organizations.PageTitle"]</PageTitle>

<div class="page-shell">
<div class="page-intro page-intro--split">
    <div>
        <h1 class="page-title">@Localizer["Organizations.PageTitle"]</h1>
        <p class="page-description">@Localizer["Organizations.Description"]</p>
    </div>
    <div class="page-actions">
        <button id="open-create-organization-panel" type="button" class="btn btn-primary" @onclick="OpenCreatePanel">@Localizer["Organizations.Panel.New"]</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger page-section" role="alert">@errorMessage</div>
}

<section class="card page-section">
    <div class="card-header">
        <h2 class="workspace-card-title mb-0">@Localizer["Organizations.Filters.Title"]</h2>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="organization-search">@Localizer["Common.Search"]</label>
                <input id="organization-search" class="form-control" @bind="search" @bind:event="oninput" placeholder="@Localizer["Organizations.Filters.SearchPlaceholder"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="organization-type-filter">@Localizer["Common.Type"]</label>
                <select id="organization-type-filter" class="form-select" @bind="selectedType">
                    <option value="">@Localizer["Common.Any"]</option>
                    @foreach (var type in organizationTypes)
                    {
                        <option value="@type.Name">@type.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="organization-province-filter">@Localizer["Common.Province"]</label>
                <select id="organization-province-filter" class="form-select" @bind="selectedProvince">
                    <option value="">@Localizer["Common.Any"]</option>
                    @foreach (var province in DistinctProvinces)
                    {
                        <option value="@province">@province</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="organization-city-filter">@Localizer["Common.City"]</label>
                <select id="organization-city-filter" class="form-select" @bind="selectedCity">
                    <option value="">@Localizer["Common.Any"]</option>
                    @foreach (var city in DistinctCities)
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">@Localizer["Common.Clear"]</button>
            </div>
        </div>
    </div>
</section>

<section class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="workspace-card-title mb-0">@Localizer["Organizations.List.Title"]</h2>
        <span class="badge text-bg-secondary">@Localizer["Organizations.List.Count", FilteredOrganizations.Count]</span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th scope="col">@Localizer["Common.Name"]</th>
                    <th scope="col">@Localizer["Common.Type"]</th>
                    <th scope="col">@Localizer["Common.City"]</th>
                    <th scope="col">@Localizer["Common.Country"]</th>
                    <th scope="col">@Localizer["Organizations.List.ContactCount"]</th>
                    <th scope="col">@Localizer["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="6">@Localizer["Organizations.List.Loading"]</td>
                    </tr>
                }
                else if (FilteredOrganizations.Count == 0)
                {
                    <tr>
                        <td colspan="6">@Localizer["Organizations.List.Empty"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var organization in PagedOrganizations)
                    {
                        <tr>
                            <td>@organization.Name</td>
                            <td>@(organization.Type ?? "-")</td>
                            <td>@(organization.City ?? "-")</td>
                            <td>@(organization.Country ?? "-")</td>
                            <td>@ContactCount(organization.Id)</td>
                            <td class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectOrganization(organization)">@Localizer["Common.Edit"]</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteOrganizationAsync(organization)">@Localizer["Common.Delete"]</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <Pagination CurrentPage="currentPage" CurrentPageChanged="OnPageChanged" PageSize="PageSize" TotalItems="FilteredOrganizations.Count" />
</section>

@if (isCreatePanelOpen)
{
    <div class="side-panel-scrim" @onclick="CloseCreatePanel"></div>
    <aside class="side-panel">
        <EditForm Model="newOrganization" OnValidSubmit="SaveOrganizationAsync">
            <DataAnnotationsValidator />
            <div class="side-panel-header">
                <h2 class="workspace-card-title mb-0">@(editingOrganization is null ? Localizer["Organizations.Form.CreateTitle"] : Localizer["Organizations.Form.EditTitle"])</h2>
                <button type="button" class="side-panel-close" @onclick="CloseCreatePanel" aria-label="@Localizer["Common.Close"]">&times;</button>
            </div>
            <div class="side-panel-body">
                <ValidationSummary />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="organization-name">@Localizer["Common.Name"]</label>
                        <InputText id="organization-name" class="form-control" @bind-Value="newOrganization.Name" />
                    </div>
                    <div class="col-md-6 combo-wrap">
                        <label class="form-label" for="organization-type">@Localizer["Common.Type"]</label>
                        <input id="organization-type" class="form-control" type="text" autocomplete="off"
                               placeholder="@Localizer["Organizations.Form.TypePlaceholder"]"
                               value="@typeQuery"
                               @oninput="OnTypeQueryChanged"
                               @onfocus="OnTypeFocus"
                               @onblur="OnTypeBlur" />
                        @if (typeDropdownOpen)
                        {
                            <div class="combo-dropdown">
                                @foreach (var type in TypeMatches.Take(8))
                                {
                                    <div class="combo-item" @onmousedown:preventDefault="true" @onclick="() => SelectType(type)">@type.Name</div>
                                }
                                @if (ShowCreateTypeOption)
                                {
                                    <div class="combo-item combo-item--create" @onmousedown:preventDefault="true" @onclick="CreateAndSelectTypeAsync">
                                        @Localizer["Organizations.Form.TypeCreateOption", typeQuery!.Trim()]
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="organization-website">@Localizer["Common.Website"]</label>
                        <InputText id="organization-website" class="form-control" @bind-Value="newOrganization.Website" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="organization-city">@Localizer["Common.City"]</label>
                        <InputText id="organization-city" class="form-control" @bind-Value="newOrganization.City" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="organization-province">@Localizer["Common.Province"]</label>
                        <InputText id="organization-province" class="form-control" @bind-Value="newOrganization.Province" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="organization-country">@Localizer["Common.Country"]</label>
                        <InputText id="organization-country" class="form-control" @bind-Value="newOrganization.Country" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="organization-notes">@Localizer["Common.Notes"]</label>
                        <InputTextArea id="organization-notes" class="form-control" @bind-Value="newOrganization.Notes" />
                    </div>
                </div>

                @if (editingOrganization is not null)
                {
                    <div class="workspace-panel mt-3">
                        <p class="workspace-card-title mb-3">@Localizer["Organizations.Members.Title", organizationMembers.Count]</p>
                        @if (organizationMembers.Count == 0)
                        {
                            <p class="text-muted mb-0">@Localizer["Organizations.Members.Empty"]</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var member in organizationMembers)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <a href="@($"/contacts/{member.Id}")">@member.DisplayName</a>
                                        <span class="small text-muted">@member.Email</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
            <div class="side-panel-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreatePanel" disabled="@isSaving">@Localizer["Common.Cancel"]</button>
                <button type="submit" class="btn @(editingOrganization is null ? "btn-success" : "btn-primary")" disabled="@isSaving">@(editingOrganization is null ? Localizer["Organizations.Form.CreateAction"] : Localizer["Common.Save"])</button>
            </div>
        </EditForm>
    </aside>
}
</div>

@code {
    private const int PageSize = 25;

    private IReadOnlyList<OrganizationDto> organizations = [];
    private IReadOnlyList<OrganizationTypeDto> organizationTypes = [];
    private IReadOnlyList<ContactDto> allContacts = [];
    private IReadOnlyList<ContactDto> organizationMembers = [];
    private OrganizationFormModel newOrganization = new();
    private OrganizationDto? editingOrganization;
    private bool isCreatePanelOpen;
    private string? errorMessage;
    private bool isLoading;
    private bool isSaving;
    private int currentPage = 1;
    private string? search;
    private string? selectedType;
    private string? selectedProvince;
    private string? selectedCity;
    private string? typeQuery;
    private bool typeDropdownOpen;

    private IReadOnlyList<string> DistinctProvinces => DistinctValues(organizations.Select(o => o.Province));

    private IReadOnlyList<string> DistinctCities => DistinctValues(organizations.Select(o => o.City));

    private IReadOnlyList<OrganizationDto> FilteredOrganizations => organizations
        .Where(organization => string.IsNullOrWhiteSpace(search) ||
            organization.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
        .Where(organization => string.IsNullOrWhiteSpace(selectedType) ||
            string.Equals(organization.Type, selectedType, StringComparison.OrdinalIgnoreCase))
        .Where(organization => string.IsNullOrWhiteSpace(selectedProvince) ||
            string.Equals(organization.Province, selectedProvince, StringComparison.OrdinalIgnoreCase))
        .Where(organization => string.IsNullOrWhiteSpace(selectedCity) ||
            string.Equals(organization.City, selectedCity, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IEnumerable<OrganizationDto> PagedOrganizations =>
        FilteredOrganizations.Skip((currentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizationsAsync();
    }

    private async Task LoadOrganizationsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            organizations = await OrganizationClient.ListAsync();
            organizationTypes = await OrganizationTypeClient.ListAsync();
            allContacts = await ContactClient.ListAsync(new ContactFilterRequest(
                Search: null,
                TagId: null,
                Status: null,
                DoNotContact: null,
                OrganizationId: null,
                LastContactedFrom: null,
                LastContactedTo: null));
            currentPage = 1;
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private int ContactCount(Guid organizationId) =>
        allContacts.Count(contact => contact.OrganizationId == organizationId);

    private void ClearFilters()
    {
        search = null;
        selectedType = null;
        selectedProvince = null;
        selectedCity = null;
        currentPage = 1;
    }

    private void OnPageChanged(int page)
    {
        currentPage = page;
    }

    private static IReadOnlyList<string> DistinctValues(IEnumerable<string?> values) => values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private async Task SaveOrganizationAsync()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            if (editingOrganization is null)
            {
                await OrganizationClient.CreateAsync(new CreateOrganizationRequest(
                    newOrganization.Name,
                    newOrganization.Type,
                    newOrganization.Website,
                    newOrganization.City,
                    newOrganization.Province,
                    newOrganization.Country,
                    newOrganization.Notes));
            }
            else
            {
                await OrganizationClient.UpdateAsync(editingOrganization.Id, new UpdateOrganizationRequest(
                    newOrganization.Name,
                    newOrganization.Type,
                    newOrganization.Website,
                    newOrganization.City,
                    newOrganization.Province,
                    newOrganization.Country,
                    newOrganization.Notes));
            }

            CloseCreatePanel();
            await LoadOrganizationsAsync();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenCreatePanel()
    {
        editingOrganization = null;
        newOrganization = new OrganizationFormModel();
        typeQuery = null;
        typeDropdownOpen = false;
        isCreatePanelOpen = true;
    }

    private void SelectOrganization(OrganizationDto organization)
    {
        editingOrganization = organization;
        newOrganization = new OrganizationFormModel
        {
            Name = organization.Name,
            Type = organization.Type,
            Website = organization.Website,
            City = organization.City,
            Province = organization.Province,
            Country = organization.Country,
            Notes = organization.Notes
        };
        typeQuery = organization.Type;
        typeDropdownOpen = false;
        organizationMembers = allContacts.Where(contact => contact.OrganizationId == organization.Id).ToList();
        isCreatePanelOpen = true;
    }

    private IReadOnlyList<OrganizationTypeDto> TypeMatches =>
        string.IsNullOrWhiteSpace(typeQuery)
            ? organizationTypes
            : organizationTypes
                .Where(type => type.Name.Contains(typeQuery, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private bool ShowCreateTypeOption =>
        !string.IsNullOrWhiteSpace(typeQuery) &&
        !organizationTypes.Any(type => string.Equals(type.Name, typeQuery.Trim(), StringComparison.OrdinalIgnoreCase));

    private void OnTypeQueryChanged(ChangeEventArgs e)
    {
        typeQuery = e.Value?.ToString();
        typeDropdownOpen = true;
        newOrganization.Type = typeQuery;
    }

    private void OnTypeFocus()
    {
        typeDropdownOpen = true;
    }

    private async Task OnTypeBlur()
    {
        await Task.Delay(150);
        typeDropdownOpen = false;
        StateHasChanged();
    }

    private void SelectType(OrganizationTypeDto type)
    {
        typeQuery = type.Name;
        newOrganization.Type = type.Name;
        typeDropdownOpen = false;
    }

    private async Task CreateAndSelectTypeAsync()
    {
        if (string.IsNullOrWhiteSpace(typeQuery))
        {
            return;
        }

        try
        {
            var created = await OrganizationTypeClient.CreateAsync(new CreateOrganizationTypeRequest(typeQuery.Trim()));
            organizationTypes = [.. organizationTypes, created];
            SelectType(created);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
    }

    private async Task DeleteOrganizationAsync(OrganizationDto organization)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", Localizer["Common.ConfirmDelete", organization.Name].Value);

        if (!confirmed)
        {
            return;
        }

        errorMessage = null;

        try
        {
            await OrganizationClient.DeleteAsync(organization.Id);

            if (editingOrganization?.Id == organization.Id)
            {
                CloseCreatePanel();
            }

            await LoadOrganizationsAsync();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
    }

    private void CloseCreatePanel()
    {
        isCreatePanelOpen = false;
        editingOrganization = null;
        newOrganization = new OrganizationFormModel();
        organizationMembers = [];
        typeQuery = null;
        typeDropdownOpen = false;
    }

    private sealed class OrganizationFormModel
    {
        [LocalizedRequired]
        public string Name { get; set; } = string.Empty;

        public string? Type { get; set; }

        public string? Website { get; set; }

        public string? City { get; set; }

        public string? Province { get; set; }

        public string? Country { get; set; }

        public string? Notes { get; set; }
    }
}
