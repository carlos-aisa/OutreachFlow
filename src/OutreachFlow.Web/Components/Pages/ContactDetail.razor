@page "/contacts/{ContactId:guid}"
@rendermode InteractiveServer
@using OutreachFlow.Application.ContactActivities
@using OutreachFlow.Application.Contacts
@using OutreachFlow.Application.ContactGroups
@using OutreachFlow.Application.FollowUps
@using OutreachFlow.Application.Organizations
@using OutreachFlow.Application.Tags
@using Microsoft.Extensions.Localization
@using OutreachFlow.Domain.Contacts
@using OutreachFlow.Domain.ContactGroups
@using OutreachFlow.Web
@using OutreachFlow.Web.Contacts
@using OutreachFlow.Web.ContactGroups
@using OutreachFlow.Web.FollowUps
@using OutreachFlow.Web.Organizations
@using OutreachFlow.Web.Tags
@inject ContactApiClient ContactClient
@inject ContactGroupApiClient ContactGroupClient
@inject FollowUpTaskApiClient FollowUpClient
@inject OrganizationApiClient OrganizationClient
@inject TagApiClient TagClient
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["ContactDetail.PageTitle"]</PageTitle>

<div class="page-shell">
    <div class="page-intro page-intro--split">
        <div>
            <h1 class="page-title">@Localizer["ContactDetail.PageTitle"]</h1>
            <p class="page-description">@Localizer["ContactDetail.Description"]</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" href="/contacts">@Localizer["ContactDetail.BackAction"]</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger page-section" role="alert">@errorMessage</div>
    }

    @if (isLoading)
    {
        <p>@Localizer["ContactDetail.Loading"]</p>
    }
    else if (contact is null)
    {
        <p>@Localizer["ContactDetail.NotFound"]</p>
    }
    else
    {
        <section class="card page-section">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="workspace-card-title mb-0">@Localizer["ContactDetail.SummaryTitle"]</h2>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenEditPanel">@Localizer["Common.Edit"]</button>
            </div>
            <div class="card-body">
                <dl class="row detail-list">
                    <dt class="col-sm-3">@Localizer["Common.DisplayName"]</dt>
                    <dd class="col-sm-9">@contact.DisplayName</dd>

                    <dt class="col-sm-3">@Localizer["Common.Email"]</dt>
                    <dd class="col-sm-9">@contact.Email</dd>

                    <dt class="col-sm-3">@Localizer["Common.Organization"]</dt>
                    <dd class="col-sm-9">@(contact.OrganizationName ?? "-")</dd>

                    <dt class="col-sm-3">@Localizer["Common.Status"]</dt>
                    <dd class="col-sm-9">@SharedResourceDisplayNames.ContactStatus(Localizer, contact.Status)</dd>

                    <dt class="col-sm-3">@Localizer["Common.DoNotContact"]</dt>
                    <dd class="col-sm-9">@(contact.DoNotContact ? Localizer["Common.Yes"] : Localizer["Common.No"])</dd>

                    <dt class="col-sm-3">@Localizer["Common.Role"]</dt>
                    <dd class="col-sm-9">@(contact.Role ?? "-")</dd>

                    <dt class="col-sm-3">@Localizer["Common.Source"]</dt>
                    <dd class="col-sm-9">@(contact.Source ?? "-")</dd>

                    <dt class="col-sm-3">@Localizer["Common.Phone"]</dt>
                    <dd class="col-sm-9">@(contact.Phone ?? "-")</dd>

                    <dt class="col-sm-3">@Localizer["Contacts.List.LastContacted"]</dt>
                    <dd class="col-sm-9">@FormatDate(contact.LastContactedAt)</dd>

                    <dt class="col-sm-3">@Localizer["ContactGroups.ContactMemberships"]</dt>
                    <dd class="col-sm-9">
                        <ChipPicker TItem="ContactGroupDto"
                                    ReadOnly="true"
                                    Items="allGroups"
                                    SelectedIds="memberGroupIds"
                                    DisplayText="@(group => group.Name)"
                                    GetId="@(group => group.Id)" />
                    </dd>

                    <dt class="col-sm-3">@Localizer["Common.Tags"]</dt>
                    <dd class="col-sm-9">
                        <ChipPicker TItem="TagDto"
                                    ReadOnly="true"
                                    Items="tags"
                                    SelectedIds="contactTagIds"
                                    DisplayText="@(tag => FormatTag(tag.Name, tag.Category))"
                                    GetId="@(tag => tag.Id)" />
                    </dd>
                </dl>
            </div>
        </section>

        <section class="card page-section">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="workspace-card-title mb-0">@Localizer["ContactDetail.ActivityTitle"]</h2>
                    <p class="workspace-card-subtitle">@Localizer["ContactDetail.ActivitySubtitle"]</p>
                </div>
                <span class="badge text-bg-secondary">@Localizer["ContactDetail.EventsCount", activities.Count]</span>
            </div>
            <div class="card-body">
                @if (activities.Count == 0)
                {
                    <p class="mb-0">@Localizer["ContactDetail.NoActivity"]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["ContactDetail.Occurred"]</th>
                                    <th scope="col">@Localizer["Common.Type"]</th>
                                    <th scope="col">@Localizer["Common.Subject"]</th>
                                    <th scope="col">@Localizer["ContactDetail.BodyPreview"]</th>
                                    <th scope="col">@Localizer["ContactDetail.Metadata"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in activities)
                                {
                                    <tr>
                                        <td>@FormatDate(activity.OccurredAt)</td>
                                        <td>@SharedResourceDisplayNames.ContactActivityType(Localizer, activity.Type)</td>
                                        <td>@(string.IsNullOrWhiteSpace(activity.Subject) ? "-" : activity.Subject)</td>
                                        <td>@(string.IsNullOrWhiteSpace(activity.BodyPreview) ? "-" : activity.BodyPreview)</td>
                                        <td><code>@(string.IsNullOrWhiteSpace(activity.MetadataJson) ? "-" : activity.MetadataJson)</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        <section class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="workspace-card-title mb-0">@Localizer["ContactDetail.FollowUpsTitle"]</h2>
                    <p class="workspace-card-subtitle">@Localizer["ContactDetail.FollowUpsSubtitle"]</p>
                </div>
                <a class="btn btn-sm btn-outline-primary" href="/follow-ups">@Localizer["ContactDetail.ManageFollowUps"]</a>
            </div>
            <div class="card-body">
                @if (followUps.Count == 0)
                {
                    <p class="mb-0">@Localizer["ContactDetail.NoFollowUps"]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Common.Due"]</th>
                                    <th scope="col">@Localizer["Common.Type"]</th>
                                    <th scope="col">@Localizer["Common.Notes"]</th>
                                    <th scope="col">@Localizer["Common.Status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in followUps)
                                {
                                    <tr>
                                        <td>@FormatDate(task.DueAt)</td>
                                        <td>@SharedResourceDisplayNames.FollowUpTaskType(Localizer, task.Type)</td>
                                        <td>@(string.IsNullOrWhiteSpace(task.Notes) ? "-" : task.Notes)</td>
                                        <td>@(task.IsCompleted ? Localizer["Common.Completed"] : Localizer["Common.Pending"])</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }

    @if (isEditPanelOpen && contact is not null)
    {
        <div class="side-panel-scrim" @onclick="CloseEditPanel"></div>
        <aside class="side-panel">
            <EditForm Model="editForm" OnValidSubmit="SaveContactAsync">
                <DataAnnotationsValidator />
                <div class="side-panel-header">
                    <h2 class="workspace-card-title mb-0">@Localizer["ContactDetail.EditTitle"]</h2>
                    <button type="button" class="side-panel-close" @onclick="CloseEditPanel" aria-label="@Localizer["Common.Close"]">&times;</button>
                </div>
                <div class="side-panel-body">
                    <ValidationSummary />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="contact-edit-name">@Localizer["Common.DisplayName"]</label>
                            <InputText id="contact-edit-name" class="form-control" @bind-Value="editForm.DisplayName" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="contact-edit-email">@Localizer["Common.Email"]</label>
                            <InputText id="contact-edit-email" class="form-control" @bind-Value="editForm.Email" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="contact-edit-organization">@Localizer["Common.Organization"]</label>
                            <SearchSelect TItem="OrganizationDto"
                                          Id="contact-edit-organization"
                                          Items="organizations"
                                          DisplayText="@(organization => organization.Name)"
                                          GetId="@(organization => organization.Id)"
                                          @bind-SelectedId="editForm.OrganizationId"
                                          Placeholder="@Localizer["Common.Any"]"
                                          EmptyLabel="@Localizer["Common.NoResults"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="contact-edit-phone">@Localizer["Common.Phone"]</label>
                            <InputText id="contact-edit-phone" class="form-control" @bind-Value="editForm.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="contact-edit-role">@Localizer["Common.Role"]</label>
                            <InputText id="contact-edit-role" class="form-control" @bind-Value="editForm.Role" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="contact-edit-source">@Localizer["Common.Source"]</label>
                            <InputText id="contact-edit-source" class="form-control" placeholder="@Localizer["Common.SourcePlaceholder"]" @bind-Value="editForm.Source" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="contact-edit-status">@Localizer["Common.Status"]</label>
                            <InputSelect id="contact-edit-status" class="form-select" @bind-Value="editForm.Status">
                                @foreach (var status in StatusValues)
                                {
                                    <option value="@status">@SharedResourceDisplayNames.ContactStatus(Localizer, status)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <InputCheckbox id="contact-edit-dnc" class="form-check-input" @bind-Value="editForm.DoNotContact" />
                                <label class="form-check-label" for="contact-edit-dnc">@Localizer["Common.DoNotContact"]</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Localizer["ContactGroups.ContactMemberships"]</label>
                            <ChipPicker TItem="ContactGroupDto"
                                        Id="contact-edit-add-group"
                                        Items="allGroups"
                                        SelectedIds="memberGroupIds"
                                        DisplayText="@(group => group.Name)"
                                        GetId="@(group => group.Id)"
                                        OnAdd="AddGroupAsync"
                                        OnRemove="RemoveGroupAsync"
                                        AddLabel="@Localizer["ContactGroups.AddGroup"]"
                                        RemoveLabel="@Localizer["Common.Remove"]"
                                        SearchPlaceholder="@Localizer["ContactGroups.SearchGroups"]"
                                        EmptyLabel="@Localizer["ContactGroups.NoMoreGroups"]"
                                        Disabled="@isGroupSaving" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Localizer["Common.Tags"]</label>
                            <ChipPicker TItem="TagDto"
                                        Id="contact-edit-add-tag"
                                        Items="tags"
                                        SelectedIds="contactTagIds"
                                        DisplayText="@(tag => FormatTag(tag.Name, tag.Category))"
                                        GetId="@(tag => tag.Id)"
                                        OnAdd="AddTagAsync"
                                        OnRemove="RemoveTagAsync"
                                        AddLabel="@Localizer["ContactDetail.AddTag"]"
                                        RemoveLabel="@Localizer["Common.Remove"]"
                                        SearchPlaceholder="@Localizer["ContactDetail.SearchTags"]"
                                        EmptyLabel="@Localizer["ContactDetail.NoMoreTags"]"
                                        Disabled="@isTagSaving" />
                        </div>
                    </div>
                </div>
                <div class="side-panel-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditPanel" disabled="@isSaving">@Localizer["Common.Cancel"]</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">@Localizer["Common.Save"]</button>
                </div>
            </EditForm>
        </aside>
    }
</div>

@code {
    private static readonly ContactStatus[] StatusValues = Enum.GetValues<ContactStatus>();

    [Parameter]
    public Guid ContactId { get; set; }

    private ContactDto? contact;
    private IReadOnlyList<ContactActivityDto> activities = [];
    private IReadOnlyList<FollowUpTaskDto> followUps = [];
    private IReadOnlyList<TagDto> tags = [];
    private IReadOnlyList<ContactGroupDto> allGroups = [];
    private IReadOnlyList<ContactGroupDto> memberGroups = [];
    private IReadOnlyList<OrganizationDto> organizations = [];
    private readonly ContactEditFormModel editForm = new();
    private bool isLoading;
    private bool isTagSaving;
    private bool isGroupSaving;
    private bool isSaving;
    private bool isEditPanelOpen;
    private string? errorMessage;

    private HashSet<Guid> contactTagIds => contact?.Tags.Select(tag => tag.Id).ToHashSet() ?? [];

    private HashSet<Guid> memberGroupIds => memberGroups.Select(group => group.Id).ToHashSet();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            contact = await ContactClient.GetByIdAsync(ContactId);
            activities = await ContactClient.ListActivitiesAsync(ContactId);
            followUps = await FollowUpClient.ListAsync(new FollowUpTaskFilterRequest(
                ContactId,
                IsCompleted: null,
                DueFrom: null,
                DueTo: null,
                Limit: 20));
            tags = await TagClient.ListAsync();
            allGroups = await ContactGroupClient.ListAsync();
            memberGroups = await ContactGroupClient.ListForContactAsync(ContactId);
            organizations = await OrganizationClient.ListAsync();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
            ResetOnError();
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
            ResetOnError();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetOnError()
    {
        contact = null;
        activities = [];
        followUps = [];
        tags = [];
        allGroups = [];
        memberGroups = [];
        organizations = [];
    }

    private void OpenEditPanel()
    {
        if (contact is null)
        {
            return;
        }

        editForm.DisplayName = contact.DisplayName;
        editForm.Email = contact.Email;
        editForm.OrganizationId = contact.OrganizationId;
        editForm.Phone = contact.Phone;
        editForm.Role = contact.Role;
        editForm.Source = contact.Source;
        editForm.Status = contact.Status;
        editForm.DoNotContact = contact.DoNotContact;
        isEditPanelOpen = true;
    }

    private void CloseEditPanel()
    {
        isEditPanelOpen = false;
    }

    private async Task SaveContactAsync()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            contact = await ContactClient.UpdateAsync(ContactId, new UpdateContactRequest(
                editForm.OrganizationId,
                editForm.DisplayName,
                editForm.Email,
                editForm.Phone,
                editForm.Role,
                editForm.Source,
                editForm.Status,
                editForm.DoNotContact));
            isEditPanelOpen = false;
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task AddTagAsync(TagDto tag) =>
        RunTagChangeAsync(async () =>
        {
            await ContactClient.AssignTagAsync(ContactId, tag.Id);
            contact = await ContactClient.GetByIdAsync(ContactId);
        });

    private Task RemoveTagAsync(TagDto tag) =>
        RunTagChangeAsync(async () =>
        {
            await ContactClient.RemoveTagAsync(ContactId, tag.Id);
            contact = await ContactClient.GetByIdAsync(ContactId);
        });

    private async Task RunTagChangeAsync(Func<Task> operation)
    {
        isTagSaving = true;
        errorMessage = null;

        try
        {
            await operation();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isTagSaving = false;
        }
    }

    private Task AddGroupAsync(ContactGroupDto group) =>
        RunGroupChangeAsync(() => ContactGroupClient.SetOverrideAsync(group.Id, ContactId, ContactGroupOverrideType.Include));

    private Task RemoveGroupAsync(ContactGroupDto group) =>
        RunGroupChangeAsync(() => ContactGroupClient.SetOverrideAsync(group.Id, ContactId, ContactGroupOverrideType.Exclude));

    private async Task RunGroupChangeAsync(Func<Task> operation)
    {
        isGroupSaving = true;
        errorMessage = null;

        try
        {
            await operation();
            memberGroups = await ContactGroupClient.ListForContactAsync(ContactId);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isGroupSaving = false;
        }
    }

    private static string FormatTag(string name, string? category)
    {
        return string.IsNullOrWhiteSpace(category) ? name : $"{category}: {name}";
    }

    private static string FormatDate(DateTimeOffset? value)
    {
        return value is null ? "-" : value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    private sealed class ContactEditFormModel
    {
        [LocalizedRequired]
        public string DisplayName { get; set; } = string.Empty;

        [LocalizedRequired]
        [LocalizedEmailAddress]
        public string Email { get; set; } = string.Empty;

        public Guid? OrganizationId { get; set; }

        public string? Phone { get; set; }

        public string? Role { get; set; }

        public string? Source { get; set; }

        public ContactStatus Status { get; set; } = ContactStatus.New;

        public bool DoNotContact { get; set; }
    }
}
