@page "/campaigns/{Id:guid}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Localization
@using OutreachFlow.Application.Campaigns
@using OutreachFlow.Application.ContactGroups
@using OutreachFlow.Application.EmailTemplates
@using OutreachFlow.Application.SenderProfiles
@using OutreachFlow.Domain.Campaigns
@using OutreachFlow.Domain.FollowUps
@using OutreachFlow.Web
@using OutreachFlow.Web.Campaigns
@using OutreachFlow.Web.ContactGroups
@using OutreachFlow.Web.EmailTemplates
@using OutreachFlow.Web.SenderProfiles
@inject CampaignApiClient CampaignClient
@inject CampaignRecipientApiClient RecipientClient
@inject ContactGroupApiClient ContactGroupClient
@inject EmailTemplateApiClient TemplateClient
@inject SenderProfileApiClient SenderProfileClient
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@(campaign?.Name ?? Localizer["Campaigns.PageTitle"])</PageTitle>

<div class="page-shell">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger page-section" role="alert">@errorMessage</div>
    }

    @if (isLoading)
    {
        <p>@Localizer["Campaigns.Detail.Loading"]</p>
    }
    else if (campaign is not null)
    {
        <div class="page-intro page-intro--split">
            <div>
                <h1 class="page-title">@campaign.Name</h1>
                <p class="page-description">@(campaign.Description ?? string.Empty)</p>
            </div>
            <div class="page-actions">
                <span class="badge text-bg-secondary">@SharedResourceDisplayNames.CampaignStatus(Localizer, campaign.Status)</span>
                <button type="button" class="btn btn-outline-secondary" @onclick="OpenEditPanel">@Localizer["Common.Edit"]</button>
                @if (campaign.Status == CampaignStatus.Open)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync" disabled="@isBusy">@Localizer["Campaigns.Detail.CloseAction"]</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="ReopenAsync" disabled="@isBusy">@Localizer["Campaigns.Detail.ReopenAction"]</button>
                }
            </div>
        </div>

        <section class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <p class="workspace-card-subtitle mb-1">@Localizer["Campaigns.Detail.Audience"]</p>
                        <p class="mb-0">@AudienceNames</p>
                    </div>
                    <div class="col-md-4">
                        <p class="workspace-card-subtitle mb-1">@Localizer["Common.Template"]</p>
                        <p class="mb-0">@TemplateName</p>
                    </div>
                    <div class="col-md-4">
                        <p class="workspace-card-subtitle mb-1">@Localizer["Common.Created"]</p>
                        <p class="mb-0">@campaign.CreatedAt.ToString("yyyy-MM-dd")</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="workspace-card-title mb-0">@Localizer["Campaigns.Recipients.Title"]</h2>
                <span class="badge text-bg-secondary">@Localizer["Campaigns.Recipients.Count", recipients.Count]</span>
            </div>
            <div class="card-body">
                @if (campaign.Status == CampaignStatus.Open)
                {
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="campaign-generate-sender">@Localizer["Nav.SenderProfiles"]</label>
                            <select id="campaign-generate-sender" class="form-select" @bind="selectedSenderProfileId">
                                <option value="">@Localizer["DraftGeneration.SelectSender"]</option>
                                @foreach (var senderProfile in senderProfiles)
                                {
                                    <option value="@senderProfile.Id">@senderProfile.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button
                                type="button"
                                class="btn btn-primary w-100"
                                @onclick="GenerateDraftsAsync"
                                disabled="@(isGeneratingDrafts || incorporatedCount == 0)">
                                @Localizer["Campaigns.Recipients.GenerateDrafts"]
                            </button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(generateSummary))
                {
                    <div class="alert alert-info">@generateSummary</div>
                }

                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Common.Contact"]</th>
                                <th scope="col">@Localizer["Common.Status"]</th>
                                <th scope="col">@Localizer["Campaigns.Recipients.ExclusionReason"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recipients.Count == 0)
                            {
                                <tr><td colspan="3">@Localizer["Campaigns.Recipients.Empty"]</td></tr>
                            }
                            else
                            {
                                @foreach (var recipient in recipients)
                                {
                                    <tr>
                                        <td>@recipient.ContactDisplayName (@recipient.ContactEmail)</td>
                                        <td>@SharedResourceDisplayNames.CampaignRecipientStatus(Localizer, recipient.Status)</td>
                                        <td>@recipient.ExclusionReason</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        @if (campaign.Status == CampaignStatus.Open)
        {
            <section class="card mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="workspace-card-title mb-0">@Localizer["Campaigns.Recipients.Candidates"]</h2>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadCandidatesAsync">@Localizer["Common.Refresh"]</button>
                </div>
                <div class="card-body">
                    @if (candidates.Count == 0)
                    {
                        <p class="text-muted mb-0">@Localizer["Campaigns.Recipients.CandidatesEmpty"]</p>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var candidate in candidates)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@candidate.DisplayName (@candidate.Email)</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => IncorporateAsync(candidate.ContactId)">@Localizer["Campaigns.Recipients.Incorporate"]</button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }
    }

    @if (isEditPanelOpen && campaign is not null)
    {
        <div class="side-panel-scrim" @onclick="CloseEditPanel"></div>
        <aside class="side-panel">
            <EditForm Model="form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="side-panel-header">
                    <h2 class="workspace-card-title mb-0">@Localizer["Campaigns.Form.EditTitle"]</h2>
                    <button type="button" class="side-panel-close" @onclick="CloseEditPanel" aria-label="@Localizer["Common.Close"]">&times;</button>
                </div>
                <div class="side-panel-body">
                    <ValidationSummary />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="campaign-edit-name">@Localizer["Common.Name"]</label>
                            <InputText id="campaign-edit-name" class="form-control" @bind-Value="form.Name" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="campaign-edit-description">@Localizer["Common.Description"]</label>
                            <InputTextArea id="campaign-edit-description" class="form-control" @bind-Value="form.Description" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="campaign-edit-template">@Localizer["Common.Template"]</label>
                            <InputSelect id="campaign-edit-template" class="form-select" @bind-Value="form.EmailTemplateId">
                                @foreach (var template in templates)
                                {
                                    <option value="@template.Id">@template.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="campaign-edit-audience">@Localizer["Campaigns.Form.Audience"]</label>
                            <select id="campaign-edit-audience" class="form-select" multiple size="6" @onchange="OnAudienceChanged">
                                @foreach (var group in contactGroups)
                                {
                                    <option value="@group.Id" selected="@editedAudienceGroupIds.Contains(group.Id)">@group.Name</option>
                                }
                            </select>
                            <div class="form-text">@Localizer["Campaigns.Form.AudienceHelp"]</div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <InputCheckbox id="campaign-edit-followup-enabled" class="form-check-input" @bind-Value="form.FollowUpEnabled" />
                                <label class="form-check-label" for="campaign-edit-followup-enabled">@Localizer["Campaigns.Form.FollowUpEnabled"]</label>
                            </div>
                        </div>
                        @if (form.FollowUpEnabled)
                        {
                            <div class="col-md-6">
                                <label class="form-label" for="campaign-edit-followup-due-days">@Localizer["Campaigns.Form.FollowUpDueDays"]</label>
                                <InputNumber id="campaign-edit-followup-due-days" class="form-control" @bind-Value="form.FollowUpDueDays" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="campaign-edit-followup-type">@Localizer["Common.Type"]</label>
                                <InputSelect id="campaign-edit-followup-type" class="form-select" @bind-Value="form.FollowUpType">
                                    @foreach (var type in FollowUpTypes)
                                    {
                                        <option value="@type">@SharedResourceDisplayNames.FollowUpTaskType(Localizer, type)</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                    </div>
                </div>
                <div class="side-panel-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditPanel" disabled="@isBusy">@Localizer["Common.Cancel"]</button>
                    <button type="submit" class="btn btn-primary" disabled="@isBusy">@Localizer["Common.Save"]</button>
                </div>
            </EditForm>
        </aside>
    }
</div>

@code {
    private static readonly FollowUpTaskType[] FollowUpTypes = Enum.GetValues<FollowUpTaskType>();

    [Parameter]
    public Guid Id { get; set; }

    private CampaignDto? campaign;
    private IReadOnlyList<ContactGroupDto> contactGroups = [];
    private IReadOnlyList<EmailTemplateDto> templates = [];
    private IReadOnlyList<SenderProfileDto> senderProfiles = [];
    private IReadOnlyList<CampaignRecipientDto> recipients = [];
    private IReadOnlyList<CampaignRecipientCandidateDto> candidates = [];
    private readonly CampaignFormModel form = new();
    private readonly HashSet<Guid> editedAudienceGroupIds = [];
    private bool isEditPanelOpen;
    private string? errorMessage;
    private bool isLoading;
    private bool isSaving;
    private bool isGeneratingDrafts;
    private string? selectedSenderProfileId;
    private string? generateSummary;

    private bool isBusy => isSaving;

    private int incorporatedCount =>
        recipients.Count(recipient => recipient.Status == CampaignRecipientStatus.Incorporated);

    private string AudienceNames =>
        campaign is null
            ? string.Empty
            : string.Join(", ", campaign.AudienceGroupIds
                .Select(id => contactGroups.FirstOrDefault(group => group.Id == id)?.Name)
                .Where(name => name is not null));

    private string TemplateName =>
        campaign is null
            ? string.Empty
            : templates.FirstOrDefault(template => template.Id == campaign.EmailTemplateId)?.Name ?? "-";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            campaign = await CampaignClient.GetAsync(Id);
            contactGroups = await ContactGroupClient.ListAsync();
            templates = await TemplateClient.ListAsync(activeOnly: true);
            senderProfiles = await SenderProfileClient.ListAsync(activeOnly: true);
            recipients = await RecipientClient.ListAsync(Id);

            if (campaign.Status == CampaignStatus.Open)
            {
                candidates = await RecipientClient.DiscoverCandidatesAsync(Id);
            }
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCandidatesAsync()
    {
        errorMessage = null;

        try
        {
            candidates = await RecipientClient.DiscoverCandidatesAsync(Id);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
    }

    private async Task IncorporateAsync(Guid contactId)
    {
        errorMessage = null;

        try
        {
            var recipient = await RecipientClient.IncorporateAsync(Id, contactId);
            recipients = [.. recipients, recipient];
            candidates = candidates.Where(candidate => candidate.ContactId != contactId).ToArray();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
    }

    private async Task GenerateDraftsAsync()
    {
        if (!Guid.TryParse(selectedSenderProfileId, out var senderProfileId))
        {
            errorMessage = Localizer["DraftGeneration.SelectSender"];
            return;
        }

        isGeneratingDrafts = true;
        errorMessage = null;
        generateSummary = null;

        try
        {
            var result = await RecipientClient.GenerateDraftsAsync(Id, new GenerateCampaignDraftsRequest(senderProfileId, []));
            recipients = result.Recipients;
            generateSummary = Localizer["Campaigns.Recipients.GenerateSummary", result.GeneratedDrafts, result.ExcludedRecipients];
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isGeneratingDrafts = false;
        }
    }

    private void OpenEditPanel()
    {
        if (campaign is null)
        {
            return;
        }

        form.Name = campaign.Name;
        form.Description = campaign.Description;
        form.EmailTemplateId = campaign.EmailTemplateId.ToString();
        form.FollowUpEnabled = campaign.FollowUpEnabled;
        form.FollowUpDueDays = campaign.FollowUpDueDays;
        form.FollowUpType = campaign.FollowUpType;
        editedAudienceGroupIds.Clear();

        foreach (var groupId in campaign.AudienceGroupIds)
        {
            editedAudienceGroupIds.Add(groupId);
        }

        isEditPanelOpen = true;
    }

    private void CloseEditPanel()
    {
        isEditPanelOpen = false;
    }

    private void OnAudienceChanged(ChangeEventArgs args)
    {
        editedAudienceGroupIds.Clear();

        if (args.Value is string[] values)
        {
            foreach (var value in values.Where(value => Guid.TryParse(value, out _)))
            {
                editedAudienceGroupIds.Add(Guid.Parse(value));
            }
        }
    }

    private async Task SaveAsync()
    {
        if (campaign is null || !Guid.TryParse(form.EmailTemplateId, out var templateId))
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            campaign = await CampaignClient.UpdateAsync(campaign.Id, new UpdateCampaignRequest(
                form.Name,
                form.Description,
                templateId,
                form.FollowUpEnabled,
                form.FollowUpDueDays,
                form.FollowUpType));

            var currentGroupIds = campaign.AudienceGroupIds.ToHashSet();

            foreach (var groupId in editedAudienceGroupIds.Except(currentGroupIds))
            {
                campaign = await CampaignClient.AddAudienceGroupAsync(campaign.Id, groupId);
            }

            foreach (var groupId in currentGroupIds.Except(editedAudienceGroupIds))
            {
                campaign = await CampaignClient.RemoveAudienceGroupAsync(campaign.Id, groupId);
            }

            CloseEditPanel();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CloseAsync()
    {
        if (campaign is null)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            campaign = await CampaignClient.CloseAsync(campaign.Id);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ReopenAsync()
    {
        if (campaign is null)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            campaign = await CampaignClient.ReopenAsync(campaign.Id);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class CampaignFormModel
    {
        [LocalizedRequired]
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string EmailTemplateId { get; set; } = string.Empty;

        public bool FollowUpEnabled { get; set; }

        public int FollowUpDueDays { get; set; } = 7;

        public FollowUpTaskType FollowUpType { get; set; } = FollowUpTaskType.Email;
    }
}
