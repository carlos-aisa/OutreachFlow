@page "/contacts"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Localization
@using OutreachFlow.Application.Contacts
@using OutreachFlow.Application.Organizations
@using OutreachFlow.Application.Tags
@using OutreachFlow.Domain.Contacts
@using OutreachFlow.Web.Contacts
@using OutreachFlow.Web
@using OutreachFlow.Web.Organizations
@using OutreachFlow.Web.Tags
@inject ContactApiClient ContactClient
@inject OrganizationApiClient OrganizationClient
@inject TagApiClient TagClient
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Contacts.PageTitle"]</PageTitle>

<div class="page-shell">
    <div class="page-intro page-intro--split">
        <div>
            <h1 class="page-title">@Localizer["Contacts.PageTitle"]</h1>
            <p class="page-description">@Localizer["Contacts.Description"]</p>
        </div>
        <div class="page-actions">
            <button id="open-create-contact-panel" type="button" class="btn btn-primary" @onclick="OpenCreatePanel">@Localizer["Contacts.Panel.NewContact"]</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger page-section" role="alert">@errorMessage</div>
    }

    @if (createdContact is not null)
    {
        <div class="alert alert-success page-section" role="status">
            <p class="mb-2">@Localizer["Contacts.Intake.Success", createdContact.DisplayName]</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-outline-primary" href="@($"/contacts/{createdContact.Id}")">@Localizer["Contacts.Intake.ViewContact"]</a>
                <a class="btn btn-sm btn-outline-primary" href="/drafts/generate">@Localizer["Contacts.Intake.CreateDraft"]</a>
            </div>
        </div>
    }

    <section class="card page-section">
        <div class="card-header">
            <h2 class="workspace-card-title mb-0">@Localizer["Contacts.Filters.Title"]</h2>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="contact-search">@Localizer["Common.Search"]</label>
                    <input id="contact-search" class="form-control" @bind="search" placeholder="@Localizer["Contacts.Filters.SearchPlaceholder"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="contact-status">@Localizer["Common.Status"]</label>
                    <select id="contact-status" class="form-select" @bind="selectedStatus">
                        <option value="">@Localizer["Contacts.Filters.AnyStatus"]</option>
                        @foreach (var status in StatusValues)
                        {
                            <option value="@status">@SharedResourceDisplayNames.ContactStatus(Localizer, status)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="contact-organization-filter">@Localizer["Common.Organization"]</label>
                    <SearchSelect TItem="OrganizationDto"
                                  Id="contact-organization-filter"
                                  Items="organizations"
                                  DisplayText="@(o => o.Name)"
                                  GetId="@(o => o.Id)"
                                  @bind-SelectedId="selectedOrganizationId"
                                  Placeholder="@Localizer["Contacts.Filters.AnyOrganization"]"
                                  EmptyLabel="@Localizer["Common.NoResults"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="contact-tag-filter">@Localizer["Common.Tag"]</label>
                    <select id="contact-tag-filter" class="form-select" @bind="selectedTagId">
                        <option value="">@Localizer["Contacts.Filters.AnyTag"]</option>
                        @foreach (var tag in tags)
                        {
                            <option value="@tag.Id">@FormatTag(tag)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="contact-dnc-filter">@Localizer["Common.DoNotContact"]</label>
                    <select id="contact-dnc-filter" class="form-select" @bind="selectedDoNotContact">
                        <option value="">@Localizer["Common.Any"]</option>
                        <option value="true">@Localizer["Contacts.Filters.OnlyDoNotContact"]</option>
                        <option value="false">@Localizer["Contacts.Filters.ExcludeDoNotContact"]</option>
                    </select>
                </div>
                <div class="col-md-9 d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" @onclick="LoadContactsAsync" disabled="@isLoading">@Localizer["Common.ApplyFilters"]</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync" disabled="@isLoading">@Localizer["Common.Clear"]</button>
                </div>
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h2 class="workspace-card-title mb-0">@Localizer["Contacts.List.Title"]</h2>
                <p class="workspace-card-subtitle">@Localizer["Contacts.List.Subtitle"]</p>
            </div>
            <span class="badge text-bg-secondary">@Localizer["Contacts.List.Count", contacts.Count]</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Common.Name"]</th>
                        <th scope="col">@Localizer["Common.Email"]</th>
                        <th scope="col">@Localizer["Common.Organization"]</th>
                        <th scope="col">@Localizer["Common.Status"]</th>
                        <th scope="col">@Localizer["Common.DoNotContact"]</th>
                        <th scope="col">@Localizer["Common.Tags"]</th>
                        <th scope="col">@Localizer["Contacts.List.LastContacted"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="7">@Localizer["Contacts.List.Loading"]</td>
                        </tr>
                    }
                    else if (contacts.Count == 0)
                    {
                        <tr>
                            <td colspan="7">@Localizer["Contacts.List.Empty"]</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var contact in contacts)
                        {
                            <tr>
                                <td>
                                    <a href="@($"/contacts/{contact.Id}")">@contact.DisplayName</a>
                                </td>
                                <td>@contact.Email</td>
                                <td>@(contact.OrganizationName ?? "-")</td>
                                <td>@SharedResourceDisplayNames.ContactStatus(Localizer, contact.Status)</td>
                                <td>@(contact.DoNotContact ? Localizer["Common.Yes"] : Localizer["Common.No"])</td>
                                <td>@FormatContactTags(contact.Tags)</td>
                                <td>@FormatDate(contact.LastContactedAt)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (isCreatePanelOpen)
    {
        <div class="side-panel-scrim" @onclick="CloseCreatePanel"></div>
        <aside class="side-panel">
            <EditForm Model="newContact" OnValidSubmit="CreateContactAsync">
                <DataAnnotationsValidator />
                <div class="side-panel-header">
                    <div>
                        <h2 class="workspace-card-title mb-0">@Localizer["Contacts.Form.CreateTitle"]</h2>
                        <p class="workspace-card-subtitle">@Localizer["Contacts.Intake.Description"]</p>
                    </div>
                    <button type="button" class="side-panel-close" @onclick="CloseCreatePanel" aria-label="@Localizer["Common.Close"]">&times;</button>
                </div>
                <div class="side-panel-body">
                    <ValidationSummary />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="new-contact-name">@Localizer["Common.DisplayName"]</label>
                            <InputText id="new-contact-name" class="form-control" @bind-Value="newContact.DisplayName" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="new-contact-email">@Localizer["Common.Email"]</label>
                            <InputText id="new-contact-email" class="form-control" @bind-Value="newContact.Email" />
                        </div>
                        <div class="col-12 combo-wrap">
                            <label class="form-label" for="new-contact-organization">@Localizer["Common.Organization"]</label>
                            <input id="new-contact-organization" class="form-control" type="text" autocomplete="off"
                                   placeholder="@Localizer["Contacts.Organization.SearchPlaceholder"]"
                                   value="@organizationQuery"
                                   @oninput="OnOrganizationQueryChanged"
                                   @onfocus="OnOrganizationFocus"
                                   @onblur="OnOrganizationBlur" />
                            @if (organizationDropdownOpen)
                            {
                                <div class="combo-dropdown">
                                    @foreach (var organization in OrganizationMatches.Take(6))
                                    {
                                        <div class="combo-item" @onmousedown:preventDefault="true" @onclick="() => SelectOrganization(organization)">@organization.Name</div>
                                    }
                                    @if (ShowCreateOrganizationOption)
                                    {
                                        <div class="combo-item combo-item--create" @onmousedown:preventDefault="true" @onclick="MarkAsNewOrganization">
                                            @Localizer["Contacts.Organization.CreateOption", organizationQuery!.Trim()]
                                        </div>
                                    }
                                </div>
                            }
                            @if (isNewOrganization)
                            {
                                <div>
                                    <span class="org-new-badge">@Localizer["Contacts.Organization.NewBadge"]</span>
                                    <button type="button" class="org-extra-toggle" @onclick="ToggleOrganizationExtra">
                                        @(showOrganizationExtra ? Localizer["Contacts.Organization.HideDetails"] : Localizer["Contacts.Organization.AddDetails"])
                                    </button>
                                    @if (showOrganizationExtra)
                                    {
                                        <div class="workspace-panel mt-2">
                                            <p class="workspace-card-title mb-3">@Localizer["Contacts.Intake.OrganizationDetails"]</p>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label" for="new-organization-type">@Localizer["Common.Type"]</label>
                                                    <InputText id="new-organization-type" class="form-control" @bind-Value="newOrganization.Type" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="new-organization-city">@Localizer["Common.City"]</label>
                                                    <InputText id="new-organization-city" class="form-control" @bind-Value="newOrganization.City" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="new-organization-province">@Localizer["Common.Province"]</label>
                                                    <InputText id="new-organization-province" class="form-control" @bind-Value="newOrganization.Province" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="new-organization-country">@Localizer["Common.Country"]</label>
                                                    <InputText id="new-organization-country" class="form-control" @bind-Value="newOrganization.Country" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="new-contact-phone">@Localizer["Common.Phone"]</label>
                            <InputText id="new-contact-phone" class="form-control" @bind-Value="newContact.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="new-contact-role">@Localizer["Common.Role"]</label>
                            <InputText id="new-contact-role" class="form-control" @bind-Value="newContact.Role" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="new-contact-source">@Localizer["Common.Source"]</label>
                            <InputText id="new-contact-source" class="form-control" placeholder="@Localizer["Common.SourcePlaceholder"]" @bind-Value="newContact.Source" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="new-contact-status">@Localizer["Common.Status"]</label>
                            <InputSelect id="new-contact-status" class="form-select" @bind-Value="newContact.Status">
                                @foreach (var status in StatusValues)
                                {
                                    <option value="@status">@SharedResourceDisplayNames.ContactStatus(Localizer, status)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <InputCheckbox id="new-contact-dnc" class="form-check-input" @bind-Value="newContact.DoNotContact" />
                                <label class="form-check-label" for="new-contact-dnc">@Localizer["Common.DoNotContact"]</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="side-panel-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreatePanel" disabled="@isSaving">@Localizer["Common.Cancel"]</button>
                    <button type="submit" class="btn btn-success" disabled="@isSaving">@Localizer["Contacts.Form.CreateAction"]</button>
                </div>
            </EditForm>
        </aside>
    }
</div>

@code {
    private static readonly ContactStatus[] StatusValues = Enum.GetValues<ContactStatus>();

    private IReadOnlyList<ContactDto> contacts = [];
    private IReadOnlyList<OrganizationDto> organizations = [];
    private IReadOnlyList<TagDto> tags = [];
    private ContactFormModel newContact = new();
    private OrganizationFormModel newOrganization = new();
    private ContactDto? createdContact;
    private bool isCreatePanelOpen;
    private string? organizationQuery;
    private bool organizationDropdownOpen;
    private Guid? pickedOrganizationId;
    private bool isNewOrganization;
    private bool showOrganizationExtra;
    private string? search;
    private string? selectedStatus;
    private Guid? selectedOrganizationId;
    private string? selectedTagId;
    private string? selectedDoNotContact;
    private string? errorMessage;
    private bool isLoading;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        await LoadReferenceDataAsync();
        await LoadContactsAsync();
    }

    private async Task LoadReferenceDataAsync()
    {
        try
        {
            organizations = await OrganizationClient.ListAsync();
            tags = await TagClient.ListAsync();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
    }

    private async Task LoadContactsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            contacts = await ContactClient.ListAsync(new ContactFilterRequest(
                search,
                ParseGuid(selectedTagId),
                ParseStatus(selectedStatus),
                ParseBoolean(selectedDoNotContact),
                selectedOrganizationId,
                null,
                null));
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearFiltersAsync()
    {
        search = null;
        selectedStatus = null;
        selectedOrganizationId = null;
        selectedTagId = null;
        selectedDoNotContact = null;
        await LoadContactsAsync();
    }

    private async Task CreateContactAsync()
    {
        isSaving = true;
        errorMessage = null;
        createdContact = null;

        try
        {
            var organizationId = pickedOrganizationId;
            CreateOrganizationRequest? newOrganizationRequest = null;

            if (organizationId is null && !string.IsNullOrWhiteSpace(organizationQuery))
            {
                var trimmedName = organizationQuery.Trim();
                var existingMatch = organizations.FirstOrDefault(organization =>
                    string.Equals(organization.Name, trimmedName, StringComparison.OrdinalIgnoreCase));

                if (existingMatch is not null)
                {
                    organizationId = existingMatch.Id;
                }
                else
                {
                    newOrganizationRequest = new CreateOrganizationRequest(
                        trimmedName,
                        newOrganization.Type,
                        null,
                        newOrganization.City,
                        newOrganization.Province,
                        newOrganization.Country,
                        null);
                }
            }

            createdContact = await ContactClient.CreateIntakeAsync(new CreateContactIntakeRequest(
                organizationId,
                newOrganizationRequest,
                newContact.DisplayName,
                newContact.Email,
                newContact.Phone,
                newContact.Role,
                newContact.Source,
                newContact.Status,
                newContact.DoNotContact));

            isCreatePanelOpen = false;
            ResetCreateForm();
            await LoadReferenceDataAsync();
            await LoadContactsAsync();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"{Localizer["Common.ApiUnavailablePrefix"]}: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenCreatePanel()
    {
        isCreatePanelOpen = true;
    }

    private void CloseCreatePanel()
    {
        isCreatePanelOpen = false;
        ResetCreateForm();
    }

    private void ResetCreateForm()
    {
        newContact = new ContactFormModel();
        newOrganization = new OrganizationFormModel();
        organizationQuery = null;
        organizationDropdownOpen = false;
        pickedOrganizationId = null;
        isNewOrganization = false;
        showOrganizationExtra = false;
    }

    private IReadOnlyList<OrganizationDto> OrganizationMatches =>
        string.IsNullOrWhiteSpace(organizationQuery)
            ? organizations
            : organizations
                .Where(organization => organization.Name.Contains(organizationQuery, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private bool ShowCreateOrganizationOption =>
        !string.IsNullOrWhiteSpace(organizationQuery) &&
        !organizations.Any(organization => string.Equals(organization.Name, organizationQuery.Trim(), StringComparison.OrdinalIgnoreCase));

    private void OnOrganizationQueryChanged(ChangeEventArgs e)
    {
        organizationQuery = e.Value?.ToString();
        organizationDropdownOpen = true;
        pickedOrganizationId = null;
        isNewOrganization = false;
    }

    private void OnOrganizationFocus()
    {
        organizationDropdownOpen = true;
        pickedOrganizationId = null;
        isNewOrganization = false;
    }

    private async Task OnOrganizationBlur()
    {
        await Task.Delay(150);
        organizationDropdownOpen = false;
        StateHasChanged();
    }

    private void SelectOrganization(OrganizationDto organization)
    {
        organizationQuery = organization.Name;
        pickedOrganizationId = organization.Id;
        isNewOrganization = false;
        organizationDropdownOpen = false;
    }

    private void MarkAsNewOrganization()
    {
        isNewOrganization = true;
        pickedOrganizationId = null;
        organizationDropdownOpen = false;
    }

    private void ToggleOrganizationExtra()
    {
        showOrganizationExtra = !showOrganizationExtra;
    }

    private static Guid? ParseGuid(string? value)
    {
        return Guid.TryParse(value, out var id) ? id : null;
    }

    private static ContactStatus? ParseStatus(string? value)
    {
        return Enum.TryParse<ContactStatus>(value, out var status) ? status : null;
    }

    private static bool? ParseBoolean(string? value)
    {
        return bool.TryParse(value, out var result) ? result : null;
    }

    private static string FormatTag(TagDto tag)
    {
        return string.IsNullOrWhiteSpace(tag.Category) ? tag.Name : $"{tag.Category}: {tag.Name}";
    }

    private static string FormatContactTags(IReadOnlyList<ContactTagDto> contactTags)
    {
        return contactTags.Count == 0
            ? "-"
            : string.Join(", ", contactTags.Select(tag =>
                string.IsNullOrWhiteSpace(tag.Category) ? tag.Name : $"{tag.Category}: {tag.Name}"));
    }

    private static string FormatDate(DateTimeOffset? value)
    {
        return value is null ? "-" : value.Value.ToString("yyyy-MM-dd");
    }

    private sealed class ContactFormModel
    {
        [LocalizedRequired]
        public string DisplayName { get; set; } = string.Empty;

        [LocalizedRequired]
        [LocalizedEmailAddress]
        public string Email { get; set; } = string.Empty;

        public string? Phone { get; set; }

        public string? Role { get; set; }

        public string? Source { get; set; }

        public ContactStatus Status { get; set; } = ContactStatus.New;

        public bool DoNotContact { get; set; }
    }

    private sealed class OrganizationFormModel
    {
        public string? Type { get; set; }

        public string? City { get; set; }

        public string? Province { get; set; }

        public string? Country { get; set; }
    }
}
