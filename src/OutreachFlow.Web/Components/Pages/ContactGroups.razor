@page "/contact-groups"
@rendermode InteractiveServer
@using Microsoft.Extensions.Localization
@using OutreachFlow.Application.ContactGroups
@using OutreachFlow.Application.Contacts
@using OutreachFlow.Application.Tags
@using OutreachFlow.Domain.ContactGroups
@using OutreachFlow.Web
@using OutreachFlow.Web.ContactGroups
@using OutreachFlow.Web.Contacts
@using OutreachFlow.Web.Tags
@inject ContactGroupApiClient ContactGroupClient
@inject ContactApiClient ContactClient
@inject TagApiClient TagClient
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["ContactGroups.PageTitle"]</PageTitle>

<div class="page-shell">
    <div class="page-intro"><p class="page-kicker">@Localizer["ContactGroups.PageTitle"]</p><h1 class="page-title">@Localizer["ContactGroups.PageTitle"]</h1><p class="page-description">@Localizer["ContactGroups.Description"]</p></div>
    @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-danger" role="alert">@errorMessage</div> }
    <section class="card page-section"><div class="card-header"><h2 class="workspace-card-title mb-0">@(selectedGroup is null ? Localizer["ContactGroups.CreateTitle"] : Localizer["ContactGroups.EditTitle"])</h2></div><div class="card-body">
        <EditForm Model="form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><ValidationSummary />
            <div class="row g-3"><div class="col-md-6"><label class="form-label">@Localizer["Common.Name"]</label><InputText class="form-control" @bind-Value="form.Name" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["ContactGroups.Provinces"]</label><InputText class="form-control" @bind-Value="form.Provinces" placeholder="Asturias, León" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["ContactGroups.Cities"]</label><InputText class="form-control" @bind-Value="form.Cities" placeholder="Oviedo, Gijón" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["ContactGroups.OrganizationTypes"]</label><InputText class="form-control" @bind-Value="form.OrganizationTypes" /></div>
            <div class="col-12"><label class="form-label">@Localizer["ContactGroups.Tags"]</label><select class="form-select" multiple @onchange="SetSelectedTags">@foreach (var tag in tags) { <option value="@tag.Id" selected="@selectedTagIds.Contains(tag.Id)">@tag.Name</option> }</select><div class="form-text">@Localizer["ContactGroups.CriteriaHelp"]</div></div>
            <div class="col-12 d-flex gap-2"><button class="btn btn-primary" type="submit" disabled="@isSaving">@(selectedGroup is null ? Localizer["Common.Create"] : Localizer["Common.Save"])</button>@if (selectedGroup is not null) { <button class="btn btn-outline-secondary" type="button" @onclick="ClearForm">@Localizer["Common.Cancel"]</button> }</div></div>
        </EditForm>
    </div></section>
    <section class="card"><div class="card-header"><h2 class="workspace-card-title mb-0">@Localizer["ContactGroups.ListTitle"]</h2></div><div class="list-group list-group-flush">
        @foreach (var group in groups) { <div class="list-group-item d-flex justify-content-between align-items-center"><div><strong>@group.Name</strong><div class="small text-muted">@FormatCriteria(group.Criteria)</div></div><div class="btn-group"><button class="btn btn-sm btn-outline-primary" @onclick="() => SelectGroup(group)">@Localizer["Common.Edit"]</button><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(group)">@Localizer["Common.Delete"]</button></div></div> }
    </div></section>
    @if (selectedGroup is not null) { <section class="card page-section"><div class="card-header"><h2 class="workspace-card-title mb-0">@Localizer["ContactGroups.MembersTitle", selectedGroup.Name]</h2></div><div class="card-body"><p class="small text-muted">@Localizer["ContactGroups.MembersHelp"]</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>@Localizer["Common.DisplayName"]</th><th>@Localizer["Common.Email"]</th><th>@Localizer["Common.Actions"]</th></tr></thead><tbody>@foreach (var contact in contacts) { var member = members.Any(item => item.ContactId == contact.Id); <tr><td>@contact.DisplayName @(member ? "✓" : "")</td><td>@contact.Email</td><td class="btn-group"><button class="btn btn-sm btn-outline-primary" @onclick="() => SetOverrideAsync(contact.Id, ContactGroupOverrideType.Include)">@Localizer["ContactGroups.Include"]</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => SetOverrideAsync(contact.Id, ContactGroupOverrideType.Exclude)">@Localizer["ContactGroups.Exclude"]</button></td></tr> }</tbody></table></div></div></section> }
</div>

@code {
    private readonly ContactGroupForm form = new();
    private IReadOnlyList<ContactGroupDto> groups = []; private IReadOnlyList<ContactDto> contacts = []; private IReadOnlyList<ContactGroupMemberDto> members = []; private IReadOnlyList<TagDto> tags = [];
    private readonly HashSet<Guid> selectedTagIds = []; private ContactGroupDto? selectedGroup; private string? errorMessage; private bool isSaving;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { try { groups = await ContactGroupClient.ListAsync(); contacts = await ContactClient.ListAsync(new ContactFilterRequest(null, null, null, null, null, null, null)); tags = await TagClient.ListAsync(); if (selectedGroup is not null) { selectedGroup = groups.FirstOrDefault(item => item.Id == selectedGroup.Id); members = selectedGroup is null ? [] : await ContactGroupClient.ListMembersAsync(selectedGroup.Id); } } catch (Exception exception) { errorMessage = exception.Message; } }
    private async Task SaveAsync() { isSaving = true; errorMessage = null; try { var criteria = BuildCriteria(); if (selectedGroup is null) await ContactGroupClient.CreateAsync(new CreateContactGroupRequest(form.Name, criteria)); else await ContactGroupClient.UpdateAsync(selectedGroup.Id, new UpdateContactGroupRequest(form.Name, criteria)); ClearForm(); await LoadAsync(); } catch (Exception exception) { errorMessage = exception.Message; } finally { isSaving = false; } }
    private async Task SelectGroup(ContactGroupDto group) { selectedGroup = group; form.Name = group.Name; SetValues(group.Criteria, ContactGroupCriterionType.Province, value => form.Provinces = value); SetValues(group.Criteria, ContactGroupCriterionType.City, value => form.Cities = value); SetValues(group.Criteria, ContactGroupCriterionType.OrganizationType, value => form.OrganizationTypes = value); selectedTagIds.Clear(); foreach (var item in group.Criteria.Where(item => item.Type == ContactGroupCriterionType.Tag && Guid.TryParse(item.Value, out _))) selectedTagIds.Add(Guid.Parse(item.Value)); await LoadAsync(); }
    private async Task DeleteAsync(ContactGroupDto group) { try { await ContactGroupClient.DeleteAsync(group.Id); if (selectedGroup?.Id == group.Id) ClearForm(); await LoadAsync(); } catch (Exception exception) { errorMessage = exception.Message; } }
    private async Task SetOverrideAsync(Guid contactId, ContactGroupOverrideType type) { if (selectedGroup is null) return; try { await ContactGroupClient.SetOverrideAsync(selectedGroup.Id, contactId, type); members = await ContactGroupClient.ListMembersAsync(selectedGroup.Id); } catch (Exception exception) { errorMessage = exception.Message; } }
    private void SetSelectedTags(ChangeEventArgs args) { selectedTagIds.Clear(); if (args.Value is string[] values) foreach (var value in values.Where(value => Guid.TryParse(value, out _))) selectedTagIds.Add(Guid.Parse(value)); }
    private IReadOnlyList<ContactGroupCriterionRequest> BuildCriteria() => Values(form.Provinces, ContactGroupCriterionType.Province).Concat(Values(form.Cities, ContactGroupCriterionType.City)).Concat(Values(form.OrganizationTypes, ContactGroupCriterionType.OrganizationType)).Concat(selectedTagIds.Select(id => new ContactGroupCriterionRequest(ContactGroupCriterionType.Tag, id.ToString()))).ToArray();
    private static IEnumerable<ContactGroupCriterionRequest> Values(string source, ContactGroupCriterionType type) => source.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Select(value => new ContactGroupCriterionRequest(type, value));
    private static void SetValues(IReadOnlyList<ContactGroupCriterionRequest> criteria, ContactGroupCriterionType type, Action<string> set) => set(string.Join(", ", criteria.Where(item => item.Type == type).Select(item => item.Value)));
    private static string FormatCriteria(IReadOnlyList<ContactGroupCriterionRequest> criteria) => criteria.Count == 0 ? "Todos los contactos" : string.Join(" · ", criteria.Select(item => item.Value));
    private void ClearForm() { form.Name = form.Provinces = form.Cities = form.OrganizationTypes = string.Empty; selectedTagIds.Clear(); selectedGroup = null; members = []; }
    private sealed class ContactGroupForm { [LocalizedRequired] public string Name { get; set; } = string.Empty; public string Provinces { get; set; } = string.Empty; public string Cities { get; set; } = string.Empty; public string OrganizationTypes { get; set; } = string.Empty; }
}
