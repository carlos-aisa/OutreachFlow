@using Microsoft.Extensions.Localization
@using OutreachFlow.Web
@inject IStringLocalizer<SharedResource> Localizer

@if (TotalItems > 0)
{
    <div class="pagination-bar">
        <span class="pagination-summary">@Localizer["Common.Pagination.Summary", RangeStart, RangeEnd, TotalItems]</span>
        @if (TotalPages > 1)
        {
            <div class="pagination-controls">
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="() => ChangePage(CurrentPage - 1)">@Localizer["Common.Pagination.Previous"]</button>
                <span class="pagination-page">@Localizer["Common.Pagination.Page", CurrentPage, TotalPages]</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage >= TotalPages)" @onclick="() => ChangePage(CurrentPage + 1)">@Localizer["Common.Pagination.Next"]</button>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public EventCallback<int> CurrentPageChanged { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 25;

    [Parameter]
    public int TotalItems { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)PageSize));

    private int RangeStart => TotalItems == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;

    private int RangeEnd => Math.Min(CurrentPage * PageSize, TotalItems);

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage)
        {
            return;
        }

        CurrentPage = page;
        await CurrentPageChanged.InvokeAsync(page);
    }
}
